# Transport Stack API key (https://delhi.transportstack.in) - sent as x-api-key header
TS_API_KEY=your-transport-stack-api-key
# Optional overrides
# CROWDWISE_DATA_DIR=./data
# CROWDWISE_MODELS_DIR=./models
# CROWDWISE_BUCKET_MINUTES=30
# CROWDWISE_CORS_ORIGINS=http://localhost:5173

# Branded account emails (verification, password reset), sent by the backend over SMTP.
# Gmail: turn on 2-step verification for the sending account, then create an "App password".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM_NAME=DelhiRaahi
